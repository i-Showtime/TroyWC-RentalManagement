@model UnitFormViewModel
@{
    var isNew = Model.Id is null;
}

<form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post">
    <div class="modal-header">
        <h5 class="modal-title">@(isNew ? "New unit" : "Edit unit")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="PropertyId" class="form-label"></label>
            <select asp-for="PropertyId" asp-items="Model.Properties" class="form-select">
                <option value="">Select a property…</option>
            </select>
            <span asp-validation-for="PropertyId" class="text-danger"></span>
        </div>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="UnitNumber" class="form-label"></label>
                <input asp-for="UnitNumber" class="form-control" />
                <span asp-validation-for="UnitNumber" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Bedrooms" class="form-label"></label>
                <select asp-for="Bedrooms" class="form-select">
                    <option value="">Select…</option>
                    <option value="0">Studio</option>
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                </select>
                <span asp-validation-for="Bedrooms" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="RentAmount" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input asp-for="RentAmount" type="number" step="0.01" min="0.01" class="form-control" />
                </div>
                <span asp-validation-for="RentAmount" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
