@model DeleteViewModel

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <div class="modal-header">
        <h5 class="modal-title">Delete @Model.EntityName</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        @if (Model.BlockedReason is not null)
        {
            <div class="alert alert-warning mb-0" role="alert">@Model.BlockedReason</div>
        }
        else
        {
            <p class="mb-0">Are you sure you want to delete <strong>@Model.DisplayName</strong>?</p>
        }
    </div>
    <div class="modal-footer">
        @if (Model.BlockedReason is not null)
        {
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        }
        else
        {
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-danger">Delete</button>
        }
    </div>
</form>
