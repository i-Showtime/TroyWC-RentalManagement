@* Step 3: read-only summary of steps 1 and 2. Submit is the only action and only while the application is editable. *@
@model RentalApplicationViewModel

<form method="post" asp-controller="Applications" asp-action="Submit" asp-route-id="@Model.Id">
    <input type="hidden" asp-for="RowVersion" />
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

    <partial name="_ApplicationSummary" model="Model" view-data='new ViewDataDictionary(ViewData) { ["ForApplicant"] = true }' />

    <div class="d-flex justify-content-between align-items-center mt-4">
        <a class="btn btn-outline-secondary" asp-controller="Applications" asp-action="Residences" asp-route-id="@Model.Id">Back</a>
        @if (Model.IsEditable)
        {
            <div class="text-end">
                <button type="submit" class="btn btn-success" disabled="@(!Model.CanSubmit)">Submit application</button>
                @if (!Model.CanSubmit)
                {
                    <div class="small text-muted mt-1">Complete both sections to submit.</div>
                }
            </div>
        }
    </div>
</form>
