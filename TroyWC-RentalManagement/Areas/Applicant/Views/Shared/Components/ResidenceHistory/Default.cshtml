@* Step 2. The list round-trips as hidden Residences[i].* inputs; the modal (ResidenceDraft.*) sits inside the same form,
   so adding, editing or removing a residence only changes the form until Continue or Save. See wwwroot/js/rental-application.js. *@
@model RentalApplicationViewModel
@{
    var editable = Model.IsEditable;

    IEnumerable<string> ErrorsFor(string prefix) => ViewContext.ViewData.ModelState
        .Where(entry => entry.Key.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
        .SelectMany(entry => entry.Value!.Errors)
        .Select(error => error.ErrorMessage);
}

<form method="post" novalidate data-residence-form
      asp-controller="Applications" asp-action="Residences" asp-route-id="@Model.Id">
    <input type="hidden" asp-for="RowVersion" />
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="h5 mb-0">Prior residences</h2>
        @if (editable)
        {
            <button type="button" class="btn btn-sm btn-outline-primary" data-residence-add>Add prior residence</button>
        }
    </div>
    <p class="text-muted small">List the places you lived before your current address. Leave this empty if there are none.</p>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">Address</th>
                    <th scope="col">Landlord</th>
                    <th scope="col">Phone</th>
                    <th scope="col">Moved in</th>
                    <th scope="col">Moved out</th>
                    @if (editable)
                    {
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model.Residences.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No prior residences.</td>
                    </tr>
                }
                @for (var i = 0; i < Model.Residences.Count; i++)
                {
                    var residence = Model.Residences[i];
                    var errors = ErrorsFor($"Residences[{i}]").ToList();

                    <tr class="@(errors.Count > 0 ? "table-danger" : null)">
                        <td>
                            @residence.Address.ToSingleLine()
                            <input type="hidden" asp-for="Residences[i].Address.Line1" />
                            <input type="hidden" asp-for="Residences[i].Address.Line2" />
                            <input type="hidden" asp-for="Residences[i].Address.City" />
                            <input type="hidden" asp-for="Residences[i].Address.State" />
                            <input type="hidden" asp-for="Residences[i].Address.PostalCode" />
                            <input type="hidden" asp-for="Residences[i].LandlordName" />
                            <input type="hidden" asp-for="Residences[i].LandlordPhone" />
                            <input type="hidden" asp-for="Residences[i].MoveInDate" />
                            <input type="hidden" asp-for="Residences[i].MoveOutDate" />
                        </td>
                        <td>@residence.LandlordName</td>
                        <td>@residence.LandlordPhone</td>
                        <td class="text-nowrap">@IsoDate.Display(residence.MoveInDate)</td>
                        <td class="text-nowrap">@IsoDate.Display(residence.MoveOutDate)</td>
                        @if (editable)
                        {
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-residence-edit="@i">Edit</button>
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        name="Command" value="@WizardCommand.RemoveResidence"
                                        formaction="@Url.Action("Residences", "Applications", new { id = Model.Id, commandIndex = i })">
                                    Remove
                                </button>
                            </td>
                        }
                    </tr>
                    @if (errors.Count > 0)
                    {
                        <tr class="table-danger">
                            <td colspan="6" class="text-danger small">
                                Edit this residence to fix: @string.Join(" ", errors)
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between mt-4">
        <a class="btn btn-outline-secondary" asp-controller="Applications" asp-action="Applicant" asp-route-id="@Model.Id">Back</a>
        @if (editable)
        {
            <div class="d-flex gap-2">
                <button type="submit" name="Command" value="@WizardCommand.Save" class="btn btn-outline-primary">Save</button>
                <button type="submit" name="Command" value="@WizardCommand.Continue" class="btn btn-primary">Continue</button>
            </div>
        }
        else
        {
            <a class="btn btn-primary" asp-controller="Applications" asp-action="Review" asp-route-id="@Model.Id">Next</a>
        }
    </div>

    @if (editable)
    {
        <div class="modal fade" id="residence-modal" tabindex="-1" aria-labelledby="residence-modal-title" aria-hidden="true"
             data-show-modal="@(Model.ShowResidenceModal ? "true" : "false")">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="residence-modal-title">Prior residence</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" asp-for="ResidenceDraftIndex" />

                        <partial name="_AddressFields" for="ResidenceDraft.Address" />

                        <div class="row g-3 mt-0">
                            <div class="col-md-6">
                                <label asp-for="ResidenceDraft.LandlordName" class="form-label"></label>
                                <input asp-for="ResidenceDraft.LandlordName" class="form-control" maxlength="200" />
                                <span asp-validation-for="ResidenceDraft.LandlordName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ResidenceDraft.LandlordPhone" class="form-label"></label>
                                <input asp-for="ResidenceDraft.LandlordPhone" class="form-control" maxlength="50" />
                                <span asp-validation-for="ResidenceDraft.LandlordPhone" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ResidenceDraft.MoveInDate" class="form-label"></label>
                                <input asp-for="ResidenceDraft.MoveInDate" type="date" class="form-control" />
                                <span asp-validation-for="ResidenceDraft.MoveInDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ResidenceDraft.MoveOutDate" class="form-label"></label>
                                <input asp-for="ResidenceDraft.MoveOutDate" type="date" class="form-control" />
                                <span asp-validation-for="ResidenceDraft.MoveOutDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary" name="Command" value="@WizardCommand.SaveResidence" data-residence-save>
                            Save residence
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</form>
